# 이 파일을 복사해서 .env 로 저장하고, 본인 경로에 맞게 수정하세요.
# .env 는 git에 올라가지 않습니다 (각자 로컬에서만 사용).

# 재무 데이터 엑셀 경로
EXCEL_PATH=data/재무관점 필수 데이터 추출.xlsx

# 실적 현황 엑셀 경로
PERF_EXCEL_PATH=data/26년 사업계획 통합관리 파일.xlsx

# KPI 데이터 엑셀 경로
KPI_EXCEL_PATH=data/KPI 지표 데이터 추출.xlsx

# PPT 원본 폴더 (재무/KPI 추출 스크립트가 스캔할 대상) — NAS 등 읽기 전용 원본 경로
EXTRACT_BASE_DIR=C:\Users\아무개\Desktop\기술교육실_프로젝트 보고서 수집
EXTRACT_KPI_ROOT_DIR=C:\Users\아무개\Desktop\기술교육실_프로젝트 보고서 수집
