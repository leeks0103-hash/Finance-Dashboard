# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/
*.egg-info/

# Node
node_modules/
frontend/node_modules/
frontend/dist/

# 테스트/브라우저 자동화 산출물
.playwright-mcp/

# 환경 설정
.env
*.local

# OS
.DS_Store
Thumbs.db
*.png
*.jpg

# 추출된 데이터 파일 (대용량 바이너리, git 제외)
data/**/*.xlsx
data/**/*.xls
data/**/*.csv
# 서버가 쓰는 설정·상태·기록 JSON 전부(하위 폴더 포함) — 새 파일이 생겨도 자동 제외. git pull이 각자 PC의 이 파일을 덮어쓰지 않게
data/**/*.json

# 로그
*.log
scripts/*.log

# 대시보드 서버 런타임 PID (dashboard_manager.py 가 기록)
dashboard.pids.json

# 현대 브랜드 폰트 (사내 배포, 각자 배치 — frontend/public/fonts/README.md 참고)
frontend/public/fonts/*.ttf
frontend/public/fonts/*.otf
frontend/public/fonts/*.woff
frontend/public/fonts/*.woff2
